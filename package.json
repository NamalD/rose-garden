{
  "name": "rose-garden",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "bun test",
    "seed": "bash scripts/seed-from-wiki.sh",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{astro,ts,css}\" \"public/**/*.css\"",
    "format:fix": "prettier --write \"src/**/*.{astro,ts,css}\" \"public/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run lint",
    "shellcheck": "shellcheck scripts/*.sh"
  },
  "dependencies": {
    "astro": "7.1.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  }
}
