---
interface Props {
  categories: string[];
  techs: string[];
  activeCategory: string | null;
  activeTechs: string[];
  onCategoryChange: (category: string | null) => void;
  onTechChange: (tech: string) => void;
  onClearTech: () => void;
}

const {
  categories,
  techs,
  activeCategory,
  activeTechs,
  onCategoryChange,
  onTechChange,
  onClearTech,
}: Props = Astro.props;
---

<div class="filter-bar">
  <div class="filter-section">
    <span class="filter-label">Category</span>
    <div class="filter-pills">
      <button
        class={`filter-pill ${activeCategory === null ? 'filter-pill-active-all' : ''}`}
        onClick={() => onCategoryChange(null)}>
        All
      </button>
      {
        categories.map((cat) => (
          <button
            class={`filter-pill ${activeCategory === cat ? 'filter-pill-active-' + cat : ''}`}
            key={cat}
            onClick={() => onCategoryChange(activeCategory === cat ? null : cat)}>
            {cat}
          </button>
        ))
      }
    </div>
  </div>

  <div class="filter-section">
    <span class="filter-label">Tech</span>
    <div class="filter-pills">
      {
        techs.map((tech) => (
          <button
            class={`filter-pill filter-pill-tech ${activeTechs.includes(tech) ? 'filter-pill-active-tech' : ''}`}
            key={tech}
            onClick={() => onTechChange(tech)}>
            {tech}
          </button>
        ))
      }
      {
        activeTechs.length > 0 && (
          <button class="filter-pill filter-pill-clear" onClick={onClearTech}>
            Clear
          </button>
        )
      }
    </div>
  </div>
</div>

<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-xxl);
  }

  .filter-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .filter-label {
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 6px 16px;
    border-radius: var(--rounded-xl);
    border: 1px solid var(--color-outline-strong);
    background: var(--color-surface);
    color: var(--color-on-surface-variant);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .filter-pill:hover {
    border-color: var(--color-primary);
  }

  .filter-pill-active-all {
    background: linear-gradient(
      180deg,
      var(--color-primary) 0%,
      var(--color-primary-gradient-end) 100%
    );
    color: #ffffff;
    border-color: transparent;
  }

  .filter-pill-active-fun {
    background: var(--color-tag-fun-bg);
    color: var(--color-tag-fun-text);
    border-color: var(--color-tag-fun-text);
  }

  .filter-pill-active-learning {
    background: var(--color-tag-learning-bg);
    color: var(--color-tag-learning-text);
    border-color: var(--color-tag-learning-text);
  }

  .filter-pill-active-useful {
    background: var(--color-tag-useful-bg);
    color: var(--color-tag-useful-text);
    border-color: var(--color-tag-useful-text);
  }

  .filter-pill-tech.filter-pill-active-tech {
    background: linear-gradient(
      180deg,
      var(--color-secondary) 0%,
      var(--color-secondary-gradient-end) 100%
    );
    color: #ffffff;
    border-color: transparent;
  }

  .filter-pill-clear {
    background: transparent;
    border-color: var(--color-outline);
    color: var(--color-on-surface-variant);
    font-size: 12px;
  }
</style>
